VEEVA_API_VERSION=v26.2
VEEVA_PROXY=http://username:password@proxy-host:port

# Microsoft Entra application credentials.
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret

# SharePoint document library identifiers.
SHAREPOINT_SITE_ID=your-sharepoint-site-id
SHAREPOINT_DRIVE_ID=your-document-library-drive-id
