# Veeva Vault credentials
VEEVA_USERNAME=your-veeva-username
VEEVA_PASSWORD=your-veeva-password

# Reference details (use a new VEEVA_REQUEST_ID per run; SharePoint folders are never overwritten)
VEEVA_INPUT_FOLDER=input
VEEVA_REQUEST_ID=CLIENT-LIST-YYYY-MM-DD
VEEVA_OUTPUT_FOLDER=output
VEEVA_VERSION_LIST=reference/<client-version-list>.xlsx

# Optional: name search for standalone veeva_download.py (WHERE name__v CONTAINS ('...'))
#VEEVA_DOCUMENT_NAME_CONTAINS=Test

# Veeva Vault authentication details (production active; UAT requires a UAT-enabled account)
AUTH_URL=https://bayer-content-factory.veevavault.com/api/v26.2/auth
#AUTH_URL=https://sbbayer-uat.veevavault.com/api/v26.2/auth
# Optional: pick a specific Vault from the sign-in response (otherwise the AUTH_URL host must match).
#VEEVA_VAULT_ID=14605
VEEVA_API_VERSION=v26.2

# Proxy details
VEEVA_PROXY=http://username:password@proxy-host:port

# SharePoint details
# Upload mode: graph (Microsoft Graph, your sign-in), sync (copy to OneDrive-synced folder), none (no upload)
SHAREPOINT_UPLOAD_METHOD=graph
# sync mode: OneDrive shortcut of the SharePoint folder
SHAREPOINT_SYNC_FOLDER=C:\Users\your-user\OneDrive - Bayer\Shortcuts\<SharePoint folder shortcut>
# graph mode: target folder "Copy link" URL; SHAREPOINT_AUTH=user (your sign-in) or app
SHAREPOINT_SHARE_URL=your-sharepoint-folder-link
SHAREPOINT_AUTH=user
# user sign-in: broker (Windows account), browser, or device
SHAREPOINT_LOGIN=broker
SHAREPOINT_LOGIN_HINT=your-company-email
# graph mode: route Graph calls through VEEVA_PROXY (true/false)
SHAREPOINT_USE_PROXY=true

# Only for SHAREPOINT_AUTH=app (Microsoft Entra app registration)
#AZURE_TENANT_ID=your-tenant-id
#AZURE_CLIENT_ID=your-app-client-id
#AZURE_CLIENT_SECRET=your-app-client-secret

# Optional alternative to SHAREPOINT_SHARE_URL
#SHAREPOINT_DRIVE_ID=your-document-library-drive-id
#SHAREPOINT_FOLDER_PATH=Approved/Veeva Deliveries